# Configuration du socle — copier en `.env.local` (gitignoré).
#
# Noms **mesurés** dans `FIDELIX/env.supabase.md` (gitignoré), pas devinés :
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY.
# `web/src/lib/supabase/config.mjs` valide les deux premières au démarrage et
# refuse un JWT de rôle `service_role` dans une variable publique.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Origine publique (déploiement) -----------------------------------------
# Ce que le QR encode (`urlAdhesion` → `/join/<slug>`) **et** l'hôte que portent
# les liens de courriel (`emailRedirectTo`). Lue à la **requête** — accès
# dynamique `env?.[NOM_ORIGINE]`, donc jamais inlinée au build : la changer ne
# demande aucun rebuild, seulement un redémarrage.
#
# Sans elle, l'origine est lue dans `x-forwarded-host` / `host`. Derrière l'edge
# d'OpenShip cet hôte est interne : une affiche imprimée avec lui est un QR mort
# collé sur un comptoir. En production, cette variable est donc **obligatoire**.
# Vide en développement = repli sur l'hôte de la requête (`http://localhost:PORT`).
NEXT_PUBLIC_SITE_URL=

# Serveur uniquement. Ne JAMAIS préfixer `NEXT_PUBLIC_` : cette clé contourne
# RLS et les `REVOKE` posés en R1.2. Une fuite ici annule le durcissement.
SUPABASE_SERVICE_ROLE_KEY=

# --- Wallet (P0-5) — Google d'abord, PassKit ensuite ------------------------
# Inerte par défaut : avec `WALLET_ENABLED=false`, aucune route n'appelle le
# réseau et `/api/wallet/google/<token>` répond `walletIndisponible` (503).
# C'est ce qui protège le scan le jour où un essai s'arrête.
#
# Google Wallet ne coûte rien (pas d'abonnement, pas de compte Apple) : il suffit
# de créer le compte émetteur dans la Google Wallet Business Console, d'activer
# l'API Google Wallet sur un projet Cloud, et de créer un **compte de service**
# dont on colle ici l'email et la clé privée.
# Serveur uniquement — jamais `NEXT_PUBLIC_` : la clé signe les pass de tous les
# clients.
#
#   GOOGLE_WALLET_ISSUER_ID        identifiant d'émetteur (`3388…`)
#   GOOGLE_WALLET_SERVICE_ACCOUNT  email du compte de service (`…iam.gserviceaccount.com`)
#   GOOGLE_WALLET_PRIVATE_KEY      PEM complet, retours à la ligne en `\n`
#   GOOGLE_WALLET_ORIGIN           domaine autorisé, sans protocole (`fidelia.ma`)
WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_ORIGIN=

# --- Web push (P0-2b) — le canal des messages, PAS la proximité --------------
# La proximité est un géorepérage inscrit dans le pass Wallet : elle ne demande
# aucune autorisation de notification et n'émet aucun envoi. Ce qui est branché
# ici, c'est l'autre canal : les messages du commerçant (`/notifications`).
#
# `NEXT_PUBLIC_VAPID_PUBLIC_KEY` est **publique** par construction — c'est elle
# que `pushManager.subscribe({ applicationServerKey })` attend, et elle voyage
# dans le bundle du navigateur. Vide = canal non branché : la page carte
# n'affiche **pas** le bloc d'opt-in, et aucune ligne n'est écrite dans
# `push_abonnements` (`0019`). Un abonnement sans émetteur serait un jeton
# orphelin.
#
# Elle se génère par paire, côté serveur, avec la clé **privée** qui reste hors
# de ce dépôt :
#     node -e "const c=require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log(c.publicKey.export({type:'spki',format:'der'}).toString('base64url').slice(-87))"
# La clé privée signe les envois : elle n'a rien à faire ici tant qu'aucun
# émetteur n'existe (P0-4b, non tranché).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Conservé pour la seconde étape : Apple demande un compte payant ou un
# intermédiaire. `PASSKIT_API_URL` et `PASSKIT_API_TOKEN` viennent du portail
# PassKit → Developer Tools, **pour ce compte** : la région et le préfixe d'API
# sont propres à chaque compte, il n'existe pas d'URL par défaut à deviner.
PASSKIT_API_URL=
PASSKIT_API_TOKEN=
PASSKIT_PROGRAM_ID=
PASSKIT_TIER_ID=
